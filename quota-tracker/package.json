{
  "name": "quota-tracker",
  "displayName": "AGY Quota Tracker",
  "description": "Shows weekly quota usage and refresh timers for Gemini and Claude models in the status bar — auto-fetched from Antigravity",
  "version": "1.2.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blaiserods26/Limit-Check"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "antigravity",
    "quota",
    "gemini",
    "claude",
    "status-bar",
    "ai",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quotaTracker.refresh",
        "title": "AGY Quota Tracker: Refresh Quota Now"
      },
      {
        "command": "quotaTracker.showDetails",
        "title": "AGY Quota Tracker: Show Quota Details"
      }
    ],
    "configuration": {
      "title": "AGY Quota Tracker",
      "properties": {
        "quotaTracker.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "How often to automatically fetch fresh quota data from Antigravity (in seconds)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
