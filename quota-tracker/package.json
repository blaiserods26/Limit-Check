{
  "name": "Quotoo",
  "displayName": "Quotoo",
  "description": "Track AI model quotas and reset countdowns in your status bar (supporting Antigravity IDE, with more coding agents planned)",
  "version": "1.0.3",
  "publisher": "BlaiseRodrigues",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blaiserods26/Limit-Check"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "quoto",
    "antigravity",
    "quota",
    "gemini",
    "claude",
    "status-bar",
    "ai",
    "llm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "quoto.refresh",
        "title": "Quotoo: Refresh Quota Now"
      },
      {
        "command": "quoto.showDetails",
        "title": "Quotoo: Show Quota Details"
      }
    ],
    "configuration": {
      "title": "Quotoo",
      "properties": {
        "quoto.refreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "How often to automatically fetch fresh quota data from Antigravity (in seconds)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce@2.32.0 package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}